# --- API keys -------------------------------------------------------------

# Required. The world engine, moderator, and structured-output checks all
# use OpenAI. Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Required when NORA_MODEL_CHARACTER is a Claude model (the default).
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...


# --- Model selection ------------------------------------------------------

# Character voice. Anthropic Claude is the recommended default — its voice
# is noticeably more natural than the OpenAI alternatives in long sessions.
# Check current model IDs at https://docs.anthropic.com/en/docs/about-claude/models
# and https://platform.openai.com/docs/models — the IDs below may shift over
# time as new versions release.
#
# Anthropic examples: claude-sonnet-4-6, claude-haiku-4-5-20251001, claude-opus-4-7
# OpenAI examples:    gpt-4o-mini, gpt-4o
NORA_MODEL_CHARACTER=claude-sonnet-4-6

# World engine and moderator MUST be OpenAI for now — they rely on
# OpenAI's structured-outputs API for schema-validated JSON.
NORA_MODEL_WORLD_ENGINE=gpt-4o
NORA_MODEL_MODERATOR=gpt-4o-mini
